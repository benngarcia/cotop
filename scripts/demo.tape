# Records docs/images/demo.gif from `cotop --demo`; nothing here touches a Colab account.
#   vhs scripts/demo.tape
Output docs/images/demo.gif
Set Shell "bash"
Set FontSize 15
Set Width 1360
Set Height 820
Set Padding 12
Set Framerate 12
Set TypingSpeed 0

Hide
Type "export PS1='$ ' && clear && .venv/bin/cotop --demo" Enter
Sleep 4s
Show
Sleep 3s
Type "j" Sleep 1.2s
Type "j" Sleep 1.2s
Type "j" Sleep 1.2s
Type "j" Sleep 2.5s
Type "j" Sleep 1.2s
Type "j" Sleep 1.2s
Type "j" Sleep 2.5s
Type "?" Sleep 3s
Type "?" Sleep 1s
Type "h" Sleep 4s
Escape Sleep 1s
Type "k" Sleep 1s
Type "s" Sleep 3s
Type "n" Sleep 2s
Hide
Type "q"
